DATABASE_URL=postgresql://usuario:password@host:5432/nombre_bd
NODE_ENV=development
PORT=3000

# Basic Auth para /swagger (la documentación no debe ser pública)
SWAGGER_USER=
SWAGGER_PASSWORD=

# Login del panel administrativo (/admin)
ADMIN_USER=
ADMIN_PASSWORD=
# Secreto para firmar la cookie de sesión del panel (cualquier cadena larga y aleatoria)
ADMIN_SESSION_SECRET=
